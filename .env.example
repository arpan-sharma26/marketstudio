# Market Studio environment variables
# Copy this file to `.env.local` and fill in values from the cloud dashboard.
# NEVER commit real credentials. `.env.local` is git-ignored.
#
# Cloud project: https://supabase.com/dashboard/project/fzbffrbdbrcqyatxvbol
# Keys: Project Settings → API

# ----------------------------------------------------------------------------
# Public (safe to expose to the browser) — must use the NEXT_PUBLIC_ prefix.
# ----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://fzbffrbdbrcqyatxvbol.supabase.co

# Supabase anonymous (publishable) key — safe for the browser, RLS-protected.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of the app (used for auth redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Server-only secrets — MUST NOT use the NEXT_PUBLIC_ prefix and MUST NOT be
# imported into any client component. Exposing these to the browser bypasses
# Row Level Security.
# ----------------------------------------------------------------------------

# Supabase service-role key — bypasses RLS. Trusted server usage only
# (seeding, webhooks, admin tasks). Never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — required only for the AI Presence Audit module.
OPENAI_API_KEY=
# Optional: override the model (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
